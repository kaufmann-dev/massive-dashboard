# PostgreSQL connection string (Drizzle + Better Auth)
DATABASE_URL="postgres://user:password@host:5432/db-name"

# Massive.com (formerly Polygon.io) API key — https://massive.com/dashboard/keys
MASSIVE_API_KEY="your-massive-api-key"

# Admin account seeded on first boot. Login is restricted to this account;
# public sign-up is disabled. Password must be at least 12 characters.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-at-least-12-chars"

# Better Auth secret for signing sessions — generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET="generate-a-random-secret"

# Public origin of the deployed app (required in production, e.g. on Coolify)
# ORIGIN="https://stocks.example.com"
